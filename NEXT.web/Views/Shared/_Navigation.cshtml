@{
    var current = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    var financeAction = "Index";
    if (current == "FinancialAccounts" && action == "Movements" &&
        Enum.TryParse<NEXT.Domain.Enums.AccountType>(Context.Request.Query["Account"].ToString(), true, out var account))
    {
        financeAction = account switch
        {
            NEXT.Domain.Enums.AccountType.Treasury => "Treasury",
            NEXT.Domain.Enums.AccountType.CustomerRefunds => "Refunds",
            _ => "Index"
        };
    }
}
<nav class="grouped-navigation" aria-label="@L["Navigation"]">
    @foreach (var group in NEXT.web.Services.NavigationCatalog.Groups)
    {
        <section class="nav-group" aria-label="@L[group.Title]">
            <h2 class="nav-group-title">@L[group.Title]</h2>
            @foreach (var item in group.Items)
            {
                var selected = current == item.Controller && (item.Controller switch
                {
                    "Inventory" => action == item.Action,
                    "FinancialAccounts" => financeAction == item.Action,
                    "FinancialControls" => action == item.Action,
                    _ => true
                });
                <a asp-controller="@item.Controller" asp-action="@item.Action" class="nav-item @(selected ? "selected" : "")" aria-current="@(selected ? "page" : null)">
                    <partial name="_Icon" model="NEXT.web.Services.UiIcons.For(item.Title)" />
                    <span>@L[item.Title]</span>
                </a>
            }
        </section>
    }
</nav>
