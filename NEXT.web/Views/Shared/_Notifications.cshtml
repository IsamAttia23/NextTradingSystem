@{
    var errors = ViewData.ModelState.Values.SelectMany(x => x.Errors).Select(x => L[x.ErrorMessage].Value).ToArray();
    var pageError = errors.Length > 0 ? string.Join("\n", errors) : Context.Response.StatusCode >= 400 ? L["RequestFailed"].Value : "";
}
<div id="notifications" class="notification-stack" aria-label="@L["Notifications"]"
     data-close="@L["Close"]" data-initial-error="@pageError" data-offline="@L["OfflineNotice"]" data-online="@L["OnlineNotice"]"
     data-image-size="@L["ImageSizeError"]" data-image-invalid="@L["ImageInvalidError"]" data-validation="@L["ValidationFailed"]"></div>
