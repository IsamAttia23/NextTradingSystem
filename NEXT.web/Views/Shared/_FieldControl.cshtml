@model NEXT.web.Models.FieldControlModel
@if (Model.Field.Type == "select")
{
    <select class="form-select" id="@Model.Id" name="@Model.Field.Name" required="@Model.Field.Required">
        <option value="">@L[Model.EmptyOption]</option>
        @foreach (var option in Model.Field.Options ?? [])
        {
            <option value="@option.Value" selected="@(Model.Field.Value == option.Value)">@L[option.Label]</option>
        }
    </select>
}
else
{
    <input class="form-control" id="@Model.Id" name="@Model.Field.Name" type="@Model.Field.Type"
           step="@(Model.Field.Type == "number" ? "any" : null)" value="@Model.Field.Value"
           required="@Model.Field.Required" maxlength="@Model.Field.MaxLength" placeholder="@Model.Placeholder"
           minlength="@(Model.Field.Type == "password" && Model.Field.Name != "CurrentPassword" ? 10 : (int?)null)"
           autocomplete="@(Model.Field.Type == "password" ? Model.Field.Name == "CurrentPassword" ? "current-password" : "new-password" : "off")" />
}
