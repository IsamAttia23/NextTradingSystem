<div class="login-intro auth-intro">
    <span class="eyebrow" dir="ltr">NEXT / @L["TradingSystem"]</span>
    <h1>@L["SecurityHeadline"]</h1>
    <p>@L["SecurityDescription"]</p>
    <div class="auth-art" aria-hidden="true">
        <div class="auth-art-background"></div>
        <div class="auth-identity-card">
            <span class="auth-avatar"><partial name="_Icon" model='@("users")' /></span>
            <i></i><i></i><span class="auth-art-dots">•••••</span>
        </div>
        <span class="auth-art-lock"><partial name="_Icon" model='@("lock")' /></span>
        <span class="auth-art-check"><partial name="_Icon" model='@("check")' /></span>
    </div>
    <p class="auth-security-note"><partial name="_Icon" model='@("shield")' /> @L["SecureAccessNote"]</p>
</div>
