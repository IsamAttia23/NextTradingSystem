@model PasswordInputModel
<div class="password-input" data-password-input
     data-show-label="@L["ShowPassword"]" data-hide-label="@L["HidePassword"]">
    <input class="form-control" id="@Model.Id" name="@Model.Name" type="password"
           autocomplete="@Model.Autocomplete" autocapitalize="none" spellcheck="false"
           required="@Model.Required" minlength="@Model.MinLength" maxlength="@Model.MaxLength"
           placeholder="@(Model.Placeholder is null ? null : L[Model.Placeholder].Value)"
           aria-describedby="@(Model.Id + "-caps")" />
    <button type="button" class="password-toggle" data-password-toggle
            aria-controls="@Model.Id" aria-pressed="false" aria-label="@L["ShowPassword"]">
        <span data-eye-open><partial name="_Icon" model='@("eye")' /></span>
        <span data-eye-closed hidden><partial name="_Icon" model='@("eye-off")' /></span>
        <span data-toggle-label>@L["ShowPassword"]</span>
    </button>
</div>
<p class="password-caps" id="@(Model.Id + "-caps")" data-caps-warning hidden role="status">@L["CapsLockWarning"]</p>
