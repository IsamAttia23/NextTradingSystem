@model ModalForm
<form action="@Model.Action" method="post" enctype="multipart/form-data" data-modal-form data-title="@L[Model.Title]">
    @Html.AntiForgeryToken()
    @if (Model.Message is not null) { <p class="form-hint @(Model.Dangerous ? "danger-note" : "")">@L[Model.Message]</p> }
    <div class="alert alert-danger" data-form-errors role="alert" tabindex="-1" hidden></div>
    @foreach (var field in Model.Fields)
    {
        var id = "field-" + field.Name.Replace(".", "-");
        <div class="mb-3">
        @if (field.Type == "checkbox")
        {
            <div class="form-check form-switch"><input class="form-check-input" id="@id" name="@field.Name" type="checkbox" value="true" checked="@(field.Value == "true")" /><label class="form-check-label" for="@id">@L[field.Label]</label><input type="hidden" name="@field.Name" value="false" /></div>
        }
        else
        {
            <label class="form-label" for="@id">@L[field.Label] @if (field.Required) { <span class="required" aria-hidden="true">*</span> }</label>
            @if (field.Type == "select")
            {
                <select class="form-select" id="@id" name="@field.Name" required="@field.Required">
                    <option value="">@L["Choose"]</option>
                    @foreach (var option in field.Options ?? []) { <option value="@option.Value" selected="@(field.Value == option.Value)">@option.Label</option> }
                </select>
            }
            else if (field.Type == "file")
            {
                <partial name="_ProfileImagePicker" model="field" />
            }
            else if (field.Type == "textarea")
            {
                <textarea class="form-control" id="@id" name="@field.Name" maxlength="@field.MaxLength" rows="3" required="@field.Required">@field.Value</textarea>
            }
            else
            {
                <input class="form-control" id="@id" name="@field.Name" type="@field.Type" value="@field.Value" required="@field.Required" maxlength="@field.MaxLength"
                       minlength="@(field.Type == "password" ? 10 : (int?)null)" autocomplete="@(field.Type == "password" ? "new-password" : "off")" />
            }
        }
        </div>
    }
    <div class="modal-form-footer"><button type="button" class="btn btn-light" data-bs-dismiss="modal">@L["Cancel"]</button><button type="submit" class="btn @(Model.Dangerous ? "btn-danger" : "btn-primary")">@L[Model.Submit]</button></div>
</form>
