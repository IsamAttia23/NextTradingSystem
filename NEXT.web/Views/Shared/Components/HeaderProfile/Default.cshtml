@model HeaderProfile
<a class="header-profile" asp-controller="Account" asp-action="Profile">
    <img class="profile-avatar avatar-image" src="@(Model.HasAvatar ? Url.Action("Avatar", "Account") : Url.Content("~/images/avatar-placeholder.svg"))" alt="@L["ProfileImage"]" />
    <div class="header-profile-copy">
        <strong>@Model.FullName</strong>
        @foreach (var field in Model.LoginHistory)
        {
            <span class="header-profile-history">@L[field.Label] <bdi>@field.Value</bdi></span>
        }
    </div>
</a>
