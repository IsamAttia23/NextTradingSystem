@model HeaderProfile
<a class="header-profile" asp-controller="Account" asp-action="Profile">
    <img class="profile-avatar" src="@(Model.HasAvatar ? Url.Action("Avatar", "Account") : Url.Content("~/logo.svg"))" alt="@L["ProfileImage"]" />
    <span>@L["Hello"] <strong>@Model.FullName</strong></span>
</a>
