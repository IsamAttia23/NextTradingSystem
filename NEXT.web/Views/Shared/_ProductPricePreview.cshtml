<section class="product-price-preview" aria-labelledby="product-prices-title">
    <h2 id="product-prices-title" class="h6">@L["ProductPricePreview"]</h2>
    <p class="form-hint">@L["ProductMarkupHint"]</p>
    <dl class="row mb-0" aria-live="polite">
        <dt class="col-7">@L["RetailPrice"]</dt>
        <dd class="col-5"><output data-price-preview="RetailPrice">—</output> SDG</dd>
        <dt class="col-7">@L["WholesalePrice"]</dt>
        <dd class="col-5"><output data-price-preview="WholesalePrice">—</output> SDG</dd>
        <dt class="col-7">@L["VipPrice"]</dt>
        <dd class="col-5"><output data-price-preview="VipPrice">—</output> SDG</dd>
    </dl>
</section>
