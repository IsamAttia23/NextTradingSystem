@model FieldControlModel
<div class="product-price-preview">
    <div>
        <label class="form-label" for="@Model.Id">
            @L[Model.Field.Label]
            @if (Model.Field.Required)
            {
                <span class="required" aria-hidden="true">*</span>
            }
        </label>
        <partial name="_FieldControl" model="Model" />
    </div>
    <div>
        <label class="form-label" for="@(Model.Id + "-price")">@L[Model.Field.Name]</label>
        <div class="product-price-value">
            <output id="@(Model.Id + "-price")" for="field-CostPrice @Model.Id" data-price-preview="@Model.Field.Name" aria-live="polite">—</output>
            <bdi>SDG</bdi>
        </div>
    </div>
</div>
