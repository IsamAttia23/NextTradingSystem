@model TableModel
<div class="filter-toolbar">
    <button type="button" class="btn filter-toggle" data-modal-template="queryFilters" data-title="@L["Filters"]"
            aria-haspopup="dialog" aria-controls="workspaceModal">
        <partial name="_Icon" model='@("filter")' />
        <span>@L["Filters"]</span>
        @if (Model.ActiveFilters > 0)
        {
            <span class="filter-count">@Model.ActiveFilters</span>
        }
    </button>
    <template id="queryFilters">
        <form method="get" action="@(Context.Request.PathBase + Context.Request.Path)" class="catalog-filters" role="search">
            <input type="hidden" name="PageSize" value="@Model.PageSize" />
            @foreach (var field in Model.FilterFields ?? [])
            {
                var fieldId = "query-" + field.Name;
                <div class="filter-field @(field.Type == "search" ? "filter-search" : "")">
                    <label for="@fieldId">@L[field.Label]</label>
                    <partial name="_FieldControl" model='@(new NEXT.web.Models.FieldControlModel(field, fieldId, "AllValues", field.Type == "search" ? L["SearchAllHint"].Value : null))' />
                </div>
            }
            @if (Model.SortOptions is {Count: > 0})
            {
                <div class="filter-field">
                    <label for="query-SortBy">@L["SortBy"]</label>
                    <select class="form-select" id="query-SortBy" name="SortBy">
                        @foreach (var option in Model.SortOptions)
                        {
                            <option value="@option.Value" selected="@((Model.Query?.SortBy ?? "Name") == option.Value)">@L[option.Label]</option>
                        }
                    </select>
                </div>
                <div class="filter-field">
                    <label for="query-SortDirection">@L["SortDirection"]</label>
                    <select class="form-select" id="query-SortDirection" name="SortDirection">
                        <option value="Ascending" selected="@(Model.Query?.SortDirection?.ToString() != "Descending")">@L["Ascending"]</option>
                        <option value="Descending" selected="@(Model.Query?.SortDirection?.ToString() == "Descending")">@L["Descending"]</option>
                    </select>
                </div>
            }
            <div class="modal-form-footer filter-actions">
                <a href="@(Context.Request.PathBase + Context.Request.Path)" class="btn btn-link filter-reset">@L["ResetFilters"]</a>
                <button class="btn btn-light" type="button" data-bs-dismiss="modal">@L["Cancel"]</button>
                <button class="btn btn-primary" type="submit"><partial name="_Icon" model='@("check")' /> @L["ApplyFilters"]</button>
            </div>
        </form>
    </template>
</div>
