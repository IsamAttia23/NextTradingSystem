@{ ViewData["Title"] = L["PasswordSavedTitle"]; }
<section class="login-grid auth-grid">
    <partial name="_AuthIntro" />
    <section class="content-card login-card auth-card auth-centered">
        <span class="auth-success-icon" aria-hidden="true"><partial name="_Icon" model='@("check")' /></span>
        <h2>@L["PasswordSavedTitle"]</h2>
        <p class="auth-description">@L["PasswordSavedDescription"]</p>
        <a class="btn btn-primary w-100" asp-action="Login">@L["Login"]</a>
    </section>
</section>
