@model PasswordChangePageModel
@{ ViewData["Title"] = L[Model.FirstLogin ? "FirstPasswordTitle" : "SetPasswordTitle"]; }
<section class="login-grid auth-grid">
    <partial name="_AuthIntro" />
    <section class="content-card login-card auth-card">
        <span class="auth-symbol" aria-hidden="true"><partial name="_Icon" model='@("key")' /></span>
        <span class="auth-step">@L[Model.FirstLogin ? "FirstLoginStep" : "StepThreeOfThree"]</span>
        <h2>@L[Model.FirstLogin ? "FirstPasswordTitle" : "SetPasswordTitle"]</h2>
        <p class="auth-description">@L[Model.FirstLogin ? "FirstPasswordDescription" : "SetPasswordDescription"]</p>
        <form asp-action="SetPassword" method="post" class="auth-form" data-password-change-form
              data-match="@L["PasswordsMatch"]" data-mismatch="@L["PasswordConfirmationMismatch"]">
            <div asp-validation-summary="All" class="text-danger" role="alert"></div>
            <div class="auth-field"><label class="form-label" for="new-password">@L["NewPassword"]</label>
                <partial name="_PasswordInput" model='@(new PasswordInputModel("new-password", "NewPassword", "NewPassword"))' />
            </div>
            <partial name="_PasswordRules" />
            <div class="auth-field"><label class="form-label" for="confirm-password">@L["ConfirmPassword"]</label>
                <partial name="_PasswordInput" model='@(new PasswordInputModel("confirm-password", "ConfirmPassword", "ConfirmPassword"))' />
            </div>
            <p class="auth-feedback" data-password-feedback role="status" aria-live="polite"></p>
            <button class="btn btn-primary w-100" type="submit" data-password-save>@L["SavePassword"]</button>
        </form>
        <p class="auth-note"><partial name="_Icon" model='@("shield")' />@L["SignInAfterPasswordChange"]</p>
    </section>
</section>
