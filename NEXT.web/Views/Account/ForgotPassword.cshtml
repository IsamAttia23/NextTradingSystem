@model RecoveryEmailInput
@{ ViewData["Title"] = L["ForgotPasswordTitle"]; }
<section class="login-grid auth-grid">
    <partial name="_AuthIntro" />
    <section class="content-card login-card auth-card">
        <a class="auth-back" asp-action="Login">@L["BackToLogin"]</a>
        <span class="auth-symbol" aria-hidden="true"><partial name="_Icon" model='@("mail")' /></span>
        <span class="auth-step">@L["StepOneOfThree"]</span>
        <h2>@L["ForgotPasswordTitle"]</h2>
        <p class="auth-description">@L["ForgotPasswordDescription"]</p>
        <form asp-action="ForgotPassword" method="post" class="auth-form" data-auth-form>
            <div class="auth-field">
                <label asp-for="Email" class="form-label">@L["Email"]</label>
                <input asp-for="Email" type="email" class="form-control" dir="ltr" autocomplete="email"
                       autocapitalize="none" spellcheck="false" maxlength="256" placeholder="you@company.com" required />
            </div>
            <button class="btn btn-primary w-100" type="submit">@L["SendVerificationCode"]</button>
        </form>
        <p class="auth-note"><partial name="_Icon" model='@("shield")' />@L["EmailVerificationNote"]</p>
    </section>
</section>
