@model LoginDto
@{
    ViewData["Title"] = L["Login"];
}
<section class="login-grid auth-grid">
    <partial name="_LoginIntro" />
    <section class="content-card login-card auth-card">
        <span class="eyebrow">@L["Welcome"]</span>
        <h2>@L["Login"]</h2>
        <p>@L["LoginDescription"]</p>
        <form asp-action="Login" method="post" class="auth-form">
            <input asp-for="ReturnUrl" type="hidden" />
            <div class="mb-3">
                <label asp-for="UserName" class="form-label">@L["UserName"]</label>
                <input asp-for="UserName" class="form-control" autocomplete="username" autocapitalize="none" spellcheck="false" maxlength="256" required />
            </div>
            <div class="mb-3">
                <label asp-for="Password" class="form-label">@L["Password"]</label>
                <partial name="_PasswordInput" model='@(new PasswordInputModel("Password", "Password", "Password", "current-password", MinLength: null))' />
            </div>
            <div class="auth-login-options">
            <div class="form-check">
                <input asp-for="RememberMe" class="form-check-input" />
                <label asp-for="RememberMe" class="form-check-label">@L["RememberMe"]</label>
            </div>
            <a class="auth-link" asp-action="ForgotPassword">@L["ForgotPasswordLink"]</a>
            </div>
            <button class="btn btn-primary w-100" type="submit">@L["Login"]</button>
        </form>
        <p class="auth-note">@L["ActivationLoginHint"]</p>
        <p class="login-note">@L["LoginNote"]</p>
    </section>
</section>
