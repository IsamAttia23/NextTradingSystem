@model ModalForm
@{
    ViewData["Title"] = L["MyProfile"];
}
<section class="page-heading">
    <div>
        <span class="eyebrow">@L["AccountSettings"]</span>
        <h1>@L["MyProfile"]</h1>
        <p>@L["ProfileDescription"]</p>
    </div>
</section>
<section class="content-card profile-settings">
    <partial name="_ModalForm" model="Model" />
</section>
