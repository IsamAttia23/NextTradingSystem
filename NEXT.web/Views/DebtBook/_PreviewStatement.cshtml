@model NEXT.Application.DTOs.Accounting.DebtBookStatement
@inject NEXT.web.Services.InvoiceDocumentAssets Assets
<section data-modal-view data-debt-statement data-title="@L["DebtBookStatementTitle", Model.Account.Name]"><style>@Html.Raw(Assets.Styles)</style><div class="invoice-document-actions"><a class="btn btn-primary" data-native-navigation asp-action="Pdf" asp-route-id="@Model.Account.Id">@L["InvoiceDocumentSavePdf"]</a><a class="btn btn-light" target="_blank" rel="noopener" asp-action="Print" asp-route-id="@Model.Account.Id" asp-route-autoPrint="true">@L["InvoiceDocumentPrint"]</a></div><partial name="~/Views/DebtBook/_StatementDocument.cshtml" model="Model"/><div class="modal-form-footer"><button class="btn btn-light" type="button" data-bs-dismiss="modal">@L["Close"]</button></div></section>
