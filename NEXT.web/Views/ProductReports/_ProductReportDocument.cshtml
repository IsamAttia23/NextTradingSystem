@model IReadOnlyList<NEXT.Application.DTOs.Products.ProductDto>
@inject TimeProvider Clock
<article class="product-report report">
<header class="report-heading"><div><partial name="~/Views/Shared/_DocumentBusinessIdentity.cshtml"/><h1>@L["ProductPriceReport"]</h1><p>@L["ProductReportSubtitle"]</p></div><div><p>@L["Date"]: <bdi>@Clock.GetLocalNow().ToString("yyyy-MM-dd")</bdi></p><p>@L["ProductReportCurrency"]</p></div></header>
<div class="report-summary"><div><span>@L["Products"]</span><strong>@Model.Count</strong></div><div><span>@L["Categories"]</span><strong>@Model.Select(p=>p.CategoryId).Distinct().Count()</strong></div><div><span>@L["Currency"]</span><strong>SDG</strong></div></div>
@if(Model.Count==0) { <p>@L["NoRecords"]</p> }
@foreach(var category in Model.GroupBy(p=>new {p.CategoryId,p.CategoryName})) {
<table><colgroup><col style="width:43%"/><col style="width:19%"/><col style="width:19%"/><col style="width:19%"/></colgroup><thead><tr><th colspan="4" class="report-category"><h2><span>@(category.Key.CategoryName ?? L["UncategorizedProducts"].Value)</span><small>@category.Count() @L["Products"]</small></h2></th></tr><tr class="report-columns"><th>@L["Name"]</th><th>@L["CostPrice"]</th><th>@L["RetailPrice"]</th><th>@L["WholesalePrice"]</th></tr></thead>
<tbody>@foreach(var p in category) { <tr><td>@p.Name</td><td><bdi>@p.CostPrice.ToString("N2")</bdi></td><td><bdi>@p.RetailPrice.ToString("N2")</bdi></td><td><bdi>@p.WholesalePrice.ToString("N2")</bdi></td></tr> }</tbody></table>
}
<footer class="report-footnote">@L["ProductReportPriceNote"]</footer>
</article>
