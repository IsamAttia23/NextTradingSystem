@model NEXT.Application.DTOs.Invoices.InvoiceDetails
@{
    ViewData["Title"] = Model.Summary.Number;
}
<section class="page-heading">
    <div>
        <span class="eyebrow">@L["Invoices"] / @L["Details"]</span>
        <h1><bdi>@Model.Summary.Number</bdi></h1>
        <p>@L[Model.Summary.Status.ToString()] · @Model.Summary.Date.ToLocalTime().ToString("g")</p>
    </div>
    <div class="details-actions">
        <button type="button" class="btn btn-light" data-modal-url="@Url.Action("Preview", "InvoiceDocuments", new { id = Model.Summary.Id })">@L["InvoiceDocumentPreview"]</button>
        <a class="btn btn-light" asp-action="Index">@L["BackToList"]</a>
        @if (Model.CanEdit)
        {
            <button type="button" class="btn btn-light" data-modal-url="@Url.Action("Edit", new { id = Model.Summary.Id })">@L["EditInvoice"]</button>
        }
        @if (Model.CanCancel)
        {
            <button type="button" class="btn btn-outline-danger" data-modal-url="@Url.Action("Cancel", new { id = Model.Summary.Id })">@L["CancelInvoice"]</button>
        }
        @if (Model.RefundableAmount > 0)
        {
            <button type="button" class="btn btn-primary" data-modal-url="@Url.Action("Refund", new { id = Model.Summary.Id })">@L["RefundInvoice"]</button>
        }
        @if (Model.CanConfirm)
        {
            <button type="button" class="btn btn-primary" data-modal-url="@Url.Action("Confirm", new { id = Model.Summary.Id })">@L["ConfirmInvoice"]</button>
        }
        @if (Model.CanRecordPayment)
        {
            <button type="button" class="btn btn-primary" data-modal-url="@Url.Action("RecordPayment", new { id = Model.Summary.Id })">@L["RecordInvoicePayment"]</button>
        }
        @if (Model.FulfillmentTargets.Count > 0)
        {
            <button type="button" class="btn btn-primary" data-modal-url="@Url.Action("Fulfill", new { id = Model.Summary.Id })">@L["ChangeInvoiceStatus"]</button>
        }
    </div>
</section>
<section class="content-card">
    <dl class="detail-grid detail-pairs">
        <div><dt>@L["CustomerName"]</dt><dd><bdi>@(Model.Summary.CustomerName ?? "—")</bdi></dd></div>
        <div><dt>@L["InvoiceCreatedBy"]</dt><dd data-invoice-created-by><bdi>@(Model.CreatedByFullName ?? "—")</bdi></dd></div>
    </dl>
    <div class="table-responsive">
        <table class="table align-middle">
            <caption class="visually-hidden">@L["InvoiceItems"]</caption>
            <thead><tr><th scope="col">@L["Product"]</th><th scope="col">@L["Quantity"]</th><th scope="col">@L["UnitPrice"]</th><th scope="col">@L["InvoiceLineTotal"]</th></tr></thead>
            <tbody>
                @foreach (var line in Model.Lines)
                {
                    <tr>
                        <td><bdi>@(line.ProductName ?? "—")</bdi></td>
                        <td><bdi>@NEXT.web.Services.FormFieldPresenter.Quantity(line.Quantity)</bdi></td>
                        <td><bdi>@line.UnitPrice.ToString("N2") SDG</bdi></td>
                        <td><bdi>@line.Total.ToString("N2") SDG</bdi></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <dl class="detail-grid detail-pairs">
        <div><dt>@L["SubTotal"]</dt><dd><bdi>@Model.SubTotal.ToString("N2") SDG</bdi></dd></div>
        <div><dt>@L["DiscountAmount"]</dt><dd><bdi>@Model.DiscountAmount.ToString("N2") SDG</bdi></dd></div>
        <div><dt>@L["TotalAmount"]</dt><dd><bdi>@Model.Summary.Total.ToString("N2") SDG</bdi></dd></div>
        <div><dt>@L["PaidAmount"]</dt><dd><bdi>@Model.PaidAmount.ToString("N2") SDG</bdi></dd></div>
        <div><dt>@L["RemainingAmount"]</dt><dd><bdi>@Model.RemainingAmount.ToString("N2") SDG</bdi></dd></div>
        @if (Model.Summary.Status != NEXT.Domain.Enums.InvoiceStatus.Cancelled)
        {
            <div><dt>@L["PaymentStatus"]</dt><dd>@L[Model.Summary.PaymentStatus.ToString()]</dd></div>
        }
        else
        {
            <div><dt>@L["InvoiceRefundedAmount"]</dt><dd><bdi>@Model.RefundedAmount.ToString("N2") SDG</bdi></dd></div>
            <div><dt>@L["InvoiceRefundableAmount"]</dt><dd><bdi>@Model.RefundableAmount.ToString("N2") SDG</bdi></dd></div>
        }
        @if (Model.LastActionAt is { } actionAt)
        {
            <div><dt>@L["InvoiceLastAction"]</dt><dd><bdi>@actionAt.ToLocalTime().ToString("g")</bdi></dd></div>
        }
    </dl>
    @if (!string.IsNullOrWhiteSpace(Model.Notes))
    {
        <div class="invoice-document-notes"><strong>@L["Notes"]</strong><p>@Model.Notes</p></div>
    }
</section>
<section class="content-card mt-3">
    <div class="card-heading"><h2>@L["InvoicePaymentHistory"]</h2></div>
    @if (Model.Payments.Count == 0)
    {
        <p>@L["InvoiceNoPayments"]</p>
    }
    else
    {
        <partial name="_InvoicePaymentTable" model="Model.Payments" />
    }
</section>
@if (Model.Refunds.Count > 0)
{
    <section class="content-card mt-3">
        <div class="card-heading"><h2>@L["InvoiceRefundHistory"]</h2></div>
        <partial name="_InvoicePaymentTable" model="Model.Refunds" />
    </section>
}
@if (Model.History.Count > 0)
{
    <section class="content-card mt-3">
        <div class="card-heading"><h2>@L["InvoiceStatusHistory"]</h2></div>
        <div class="activity-records">
            @foreach (var entry in Model.History)
            {
                <article class="activity-record">
                    <strong>@(entry.FromStatus == entry.ToStatus ? L["InvoiceEdited"] : L[entry.FromStatus.ToString()] + " ← " + L[entry.ToStatus.ToString()])</strong>
                    <p><bdi>@entry.ActorFullName</bdi> · <bdi>@entry.ActionAt.ToLocalTime().ToString("g")</bdi></p>
                    @if (!string.IsNullOrWhiteSpace(entry.Reason) && entry.FromStatus != entry.ToStatus)
                    {
                        <p>@entry.Reason</p>
                    }
                </article>
            }
        </div>
    </section>
}
