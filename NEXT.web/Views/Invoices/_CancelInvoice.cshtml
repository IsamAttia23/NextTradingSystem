@model NEXT.Application.DTOs.Invoices.InvoiceDetails
<form asp-action="Cancel" asp-route-id="@Model.Summary.Id" method="post" data-modal-form data-title="@L["CancelInvoice"]">
    <input type="hidden" name="OperationId" value="@Guid.NewGuid()" />
    <input type="hidden" name="RowVersion" value="@Convert.ToBase64String(Model.RowVersion)" />
    <p><bdi>@Model.Summary.Number</bdi> · <bdi>@Model.Summary.CustomerName</bdi></p>
    <p>@L["InvoiceCancellationNotice"]</p>
    @if (Model.PaidAmount > 0)
    {
        <div class="alert alert-info">@L["InvoiceCancellationCreditNotice"] <strong><bdi>@Model.PaidAmount.ToString("N2") SDG</bdi></strong></div>
        @if (Model.CustomerId is null && Model.DebtCustomerCandidates.Count > 0)
        {
            <label class="form-label w-100">@L["CustomerName"]
                <select name="CustomerId" class="form-select" required>
                    <option value="">@L["AccountingChooseInvoiceCustomer"]</option>
                    @foreach (var customer in Model.DebtCustomerCandidates)
                    {
                        <option value="@customer.Id">@customer.Name · @customer.Phone</option>
                    }
                </select>
            </label>
        }
    }
    <label class="form-label w-100">@L["InvoiceCancellationReason"]
        <textarea name="Reason" class="form-control" required maxlength="500" rows="3"></textarea>
    </label>
    <div class="modal-form-footer">
        <button type="button" class="btn btn-light" data-bs-dismiss="modal">@L["Close"]</button>
        <button type="submit" class="btn btn-danger">@L["CancelInvoice"]</button>
    </div>
</form>
