@model NEXT.Application.DTOs.Invoices.InvoiceDetails
@if (Model.CustomerId is null && Model.DebtCustomerCandidates.Count > 0)
{
    <label class="form-label w-100">@L["CustomerName"]
        <select name="CustomerId" class="form-select" required>
            <option value="">@L["AccountingChooseInvoiceCustomer"]</option>
            @foreach (var customer in Model.DebtCustomerCandidates)
            {
                <option value="@customer.Id">@customer.Name · @customer.Phone</option>
            }
        </select>
    </label>
}
